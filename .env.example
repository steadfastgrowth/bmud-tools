# Copy to .env (gitignored) or export in your shell before starting the relay.
# Never commit real values.

POCKET_TOKEN=change-me-to-a-long-random-string
MINI_BRIDGE=http://127.0.0.1:8787
RELAY_HOST=0.0.0.0
RELAY_PORT=8790

# Spotify / Hermes paths are read from your local Hermes auth store by default.
# IMSG_BIN=imsg
# HERMES_BIN=hermes

# Music: 0 = previews + Spotify Connect only (recommended / default)
#        1 = experimental personal handset match (see docs/MUSIC.md + DISCLAIMER.md)
MUSIC_MATCH_FULL=0
